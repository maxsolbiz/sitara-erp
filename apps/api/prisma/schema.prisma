generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE & TENANCY
// ============================================================

model Tenant {
  id          BigInt     @id @default(autoincrement())
  name        String     @db.VarChar(200)
  slug        String     @unique @db.VarChar(50)
  plan        String     @default("starter") @db.VarChar(20)
  status      String     @default("trial") @db.VarChar(20)
  trialEndsAt DateTime?  @map("trial_ends_at")
  settings    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  users                  User[]
  userSessions           UserSession[]
  activityLogs           ActivityLog[]
  roles                  Role[]
  permissions            Permission[]
  warehouses             Warehouse[]
  productCategories      ProductCategory[]
  products               Product[]
  productVariants        ProductVariant[]
  productImages          ProductImage[]
  warehouseStock         WarehouseStock[]
  stockMovements         StockMovement[]
  stockBatches           StockBatch[]
  stockAdjustments       StockAdjustment[]
  barcodes               Barcode[]
  customers              Customer[]
  customerPayments       CustomerPayment[]
  customerActivityLogs   CustomerActivityLog[]
  customerLedgers        CustomerLedger[]
  pricingTiers           PricingTier[]
  vendors                Vendor[]
  vendorPayments         VendorPayment[]
  vendorActivityLogs     VendorActivityLog[]
  vendorLedgers          VendorLedger[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  purchaseReceipts       PurchaseReceipt[]
  purchaseReceiptItems   PurchaseReceiptItem[]
  purchaseReturns        PurchaseReturn[]
  purchaseReturnItems    PurchaseReturnItem[]
  sales                  Sale[]
  saleItems              SaleItem[]
  salePayments           SalePayment[]
  salesReturns           SalesReturn[]
  salesReturnItems       SalesReturnItem[]
  returnProcessingLogs   ReturnProcessingLog[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]
  journalEntryLines      JournalEntryLine[]
  financialYears         FinancialYear[]
  tenantSettings          Setting[]
  notifications          Notification[]
  productBundles         ProductBundle[]
  productAttributes      ProductAttribute[]
  loanParties            LoanParty[]
  loans                  Loan[]
  stockTransfers         StockTransfer[]
  importHistory          ImportHistory[]
  backupRecords          BackupRecord[]

  @@map("tenants")
}

model User {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  username      String    @db.VarChar(50)
  email         String    @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(100)
  isActive      Boolean   @default(true) @map("is_active")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  status        String    @default("active") @db.VarChar(20)
  lastLogin     DateTime? @map("last_login")
  loginAttempts Int       @default(0) @map("login_attempts")
  lockedUntil   DateTime? @map("locked_until")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  resetToken    String?   @unique @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     BigInt?   @map("created_by")
  updatedBy     BigInt?   @map("updated_by")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        UserSession[]
  activityLogs    ActivityLog[]
  roleAssignments RoleUser[]
  notifications   Notification[]
  salesCreated       Sale[]          @relation("createdSales")
  customerAssignments Customer[]      @relation("CustomerSalesperson")
  backupRecordsCreated BackupRecord[] @relation("BackupCreator")
  backupRecordsRestored BackupRecord[] @relation("BackupRestorer")

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("users")
}

model UserSession {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt   @map("tenant_id")
  userId        BigInt   @map("user_id")
  sessionToken  String   @unique @map("session_token") @db.VarChar(255)
  // JTI of the currently valid refresh token for this session. Used for
  // refresh-token reuse detection (Phase 1): a presented refresh token whose
  // jti differs from this value triggers global revocation. Nullable so
  // pre-migration rows remain valid (they stamp on next rotation).
  refreshTokenJti String? @map("refresh_token_jti") @db.VarChar(255)
  ipAddress     String   @map("ip_address") @db.VarChar(45)
  userAgent     String   @map("user_agent") @db.Text
  startedAt     DateTime @default(now()) @map("started_at")
  lastActivity  DateTime @default(now()) @map("last_activity")
  expiresAt     DateTime @map("expires_at")
  isActive      Boolean  @default(true) @map("is_active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("user_sessions")
}

model ActivityLog {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  userId      BigInt?   @map("user_id")
  action      String    @db.VarChar(50)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    BigInt?   @map("entity_id")
  description String    @db.Text
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   String    @map("ip_address") @db.VarChar(45)
  userAgent   String    @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ============================================================
// RBAC
// ============================================================

model Role {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       RoleUser[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles   RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleUser {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("role_user")
}

// ============================================================
// INVENTORY
// ============================================================

model Warehouse {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(100)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  managerName String?  @map("manager_name") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stock           WarehouseStock[]
  stockMovements  StockMovement[]
  stockBatches    StockBatch[]
  stockAdjustments StockAdjustment[]
  purchaseReceipts PurchaseReceipt[]
  transfersFrom   StockTransfer[] @relation("TransferFrom")
  transfersTo     StockTransfer[] @relation("TransferTo")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model ProductCategory {
  id          BigInt            @id @default(autoincrement())
  tenantId    BigInt            @map("tenant_id")
  name        String            @db.VarChar(100)
  slug        String?           @db.VarChar(120)
  description String?           @db.Text
  parentId    BigInt?           @map("parent_id")
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   ProductCategory[] @relation("CategoryHierarchy")
  products   Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @map("tenant_id")
  sku              String   @db.VarChar(50)
  barcode          String?  @unique @db.VarChar(50)
  name             String   @db.VarChar(200)
  description      String?  @db.Text
  categoryId       BigInt?  @map("category_id")
  unitOfMeasure    String   @default("pieces") @map("unit_of_measure") @db.VarChar(20)
  costPrice        Decimal  @default(0) @map("cost_price") @db.Decimal(15, 4)
  sellingPrice     Decimal  @default(0) @map("selling_price") @db.Decimal(15, 4)
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  reorderLevel     Int      @default(10) @map("reorder_level")
  reorderQuantity  Int      @default(50) @map("reorder_quantity")
  imagePath        String?  @map("image_path") @db.VarChar(255)
  isActive         Boolean  @default(true) @map("is_active")
  isTrackInventory Boolean  @default(true) @map("is_track_inventory")
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        BigInt?  @map("created_by")
  updatedBy        BigInt?  @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  images            ProductImage[]
  warehouseStock    WarehouseStock[]
  stockMovements    StockMovement[]
  stockBatches      StockBatch[]
  stockAdjustments  StockAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems         SaleItem[]
  salesReturnItems  SalesReturnItem[]
  barcodes          Barcode[]
  bundleItems       ProductBundleItem[]
  transferItems     StockTransferItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  productId   BigInt   @map("product_id")
  sku         String   @db.VarChar(50)
  name        String   @db.VarChar(200)
  barcode     String?  @db.VarChar(50)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(15, 4)
  sellingPrice Decimal @default(0) @map("selling_price") @db.Decimal(15, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  productId BigInt  @map("product_id")
  imagePath String  @map("image_path") @db.VarChar(255)
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_images")
}

model WarehouseStock {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @map("tenant_id")
  warehouseId      BigInt   @map("warehouse_id")
  productId        BigInt   @map("product_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(15, 4)
  lastMovementAt   DateTime? @map("last_movement_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_stock")
}

model StockMovement {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  warehouseId    BigInt   @map("warehouse_id")
  productId      BigInt   @map("product_id")
  movementType   String   @map("movement_type") @db.VarChar(50)
  quantity       Int
  unitCost       Decimal? @map("unit_cost") @db.Decimal(15, 4)
  referenceType  String?  @map("reference_type") @db.VarChar(50)
  referenceId    BigInt?  @map("reference_id")
  batchNumber    String?  @map("batch_number") @db.VarChar(50)
  expiryDate     DateTime? @map("expiry_date")
  notes          String?  @db.Text
  createdBy      BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockBatch {
  id                BigInt   @id @default(autoincrement())
  tenantId          BigInt   @map("tenant_id")
  warehouseId       BigInt   @map("warehouse_id")
  productId         BigInt   @map("product_id")
  batchNumber       String   @map("batch_number") @db.VarChar(50)
  quantityReceived  Int      @map("quantity_received")
  quantityRemaining Int      @map("quantity_remaining")
  unitCost          Decimal  @map("unit_cost") @db.Decimal(15, 4)
  expiryDate        DateTime? @map("expiry_date")
  purchaseOrderId   BigInt?  @map("purchase_order_id")
  receivedAt        DateTime @map("received_at")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([warehouseId, productId])
  @@index([batchNumber])
  @@map("stock_batches")
}

model StockAdjustment {
  id                BigInt    @id @default(autoincrement())
  tenantId          BigInt    @map("tenant_id")
  warehouseId       BigInt    @map("warehouse_id")
  productId         BigInt    @map("product_id")
  adjustmentType    String    @map("adjustment_type") @db.VarChar(20)
  quantityBefore    Int       @map("quantity_before")
  quantityAdjusted  Int       @map("quantity_adjusted")
  quantityAfter     Int       @map("quantity_after")
  reason            String    @db.Text
  approvedBy        BigInt?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  createdBy         BigInt    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([adjustmentType])
  @@map("stock_adjustments")
}

model StockTransfer {
  id                BigInt              @id @default(autoincrement())
  tenantId          BigInt              @map("tenant_id")
  transferNumber    String              @map("transfer_number") @db.VarChar(50)
  fromWarehouseId   BigInt              @map("from_warehouse_id")
  toWarehouseId     BigInt              @map("to_warehouse_id")
  transferDate      DateTime            @map("transfer_date")
  reason            String?             @db.Text
  notes             String?             @db.Text
  status            String              @default("COMPLETED") @db.VarChar(20)
  createdBy         BigInt?             @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         BigInt        @id @default(autoincrement())
  transferId BigInt        @map("transfer_id")
  productId  BigInt        @map("product_id")
  quantity   Int
  notes      String?       @db.Text
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model ProductBundle {
  id           BigInt             @id @default(autoincrement())
  tenantId     BigInt             @map("tenant_id")
  name         String             @db.VarChar(200)
  description  String?            @db.Text
  sku          String             @db.VarChar(50)
  sellingPrice Decimal            @default(0) @map("selling_price") @db.Decimal(15, 2)
  isActive     Boolean            @default(true) @map("is_active")
  imagePath    String?            @map("image_path") @db.VarChar(255)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ProductBundleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("product_bundles")
}

model ProductBundleItem {
  id        BigInt        @id @default(autoincrement())
  bundleId  BigInt        @map("bundle_id")
  productId BigInt        @map("product_id")
  quantity  Int           @default(1)
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

model ProductAttribute {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  name      String   @db.VarChar(100)
  values    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_attributes")
}

model Barcode {
  id          BigInt   @id @default(autoincrement())
  tenantId     BigInt   @map("tenant_id")
  productId    BigInt?  @map("product_id")
  barcode      String   @unique @db.VarChar(50)
  barcodeType  String   @default("C128") @map("barcode_type") @db.VarChar(20)
  generatedAt  DateTime @default(now()) @map("generated_at")
  generatedBy  BigInt?  @map("generated_by")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@map("barcodes")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  customerCode   String   @map("customer_code") @db.VarChar(20)
  fullName       String   @map("full_name") @db.VarChar(200)
  email          String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  address        String?  @db.Text
  city           String?  @db.VarChar(100)
  taxNumber      String?  @map("tax_number") @db.VarChar(50)
  creditLimit    Decimal      @default(0) @map("credit_limit") @db.Decimal(15, 2)
  currentBalance Decimal      @default(0) @map("current_balance") @db.Decimal(15, 2)
  creditDays     Int      @default(0) @map("credit_days")
  customerGroup  String?  @map("customer_group") @db.VarChar(50)
  salespersonId  BigInt?  @map("salesperson_id")
  notes          String?  @db.Text
  pricingTierId  BigInt?      @map("pricing_tier_id")
  isActive       Boolean  @default(true) @map("is_active")
  barcode        String?  @unique @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      BigInt?  @map("created_by")
  deletedAt      DateTime? @map("deleted_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments     CustomerPayment[]
  activityLogs CustomerActivityLog[]
  ledger       CustomerLedger[]
  sales        Sale[]
  salesReturns SalesReturn[]
  pricingTier   PricingTier?  @relation(fields: [pricingTierId], references: [id])
  salesperson   User?      @relation("CustomerSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  @@unique([tenantId, customerCode])
  @@index([tenantId])
  @@index([barcode])
  @@index([pricingTierId])
  @@map("customers")
}

model CustomerPayment {

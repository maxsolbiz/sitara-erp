// ============================================================
// PURCHASES
// ============================================================

model PurchaseOrder {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  orderNumber     String   @map("order_number") @db.VarChar(50)
  vendorId        BigInt   @map("vendor_id")
  orderDate       DateTime @map("order_date")
  expectedDate    DateTime? @map("expected_date")
  subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  shippingCost    Decimal  @default(0) @map("shipping_cost") @db.Decimal(15, 2)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  status          String   @default("DRAFT") @db.VarChar(20)
  notes           String?  @db.Text
  createdBy       BigInt   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  financialYearId BigInt?  @map("financial_year_id")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  financialYear  FinancialYear?      @relation(fields: [financialYearId], references: [id], onDelete: SetNull)
  items          PurchaseOrderItem[]
  receipts       PurchaseReceipt[]
  purchaseReturns PurchaseReturn[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               BigInt  @id @default(autoincrement())
  tenantId         BigInt  @map("tenant_id")
  purchaseOrderId  BigInt  @map("purchase_order_id")
  productId        BigInt  @map("product_id")
  quantityOrdered  Int     @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  unitCost         Decimal @map("unit_cost") @db.Decimal(15, 4)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discountPercent  Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(15, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @map("tenant_id")
  receiptNumber    String   @map("receipt_number") @db.VarChar(50)
  purchaseOrderId  BigInt   @map("purchase_order_id")
  warehouseId      BigInt   @map("warehouse_id")
  receiptDate      DateTime @map("receipt_date")
  totalItems       Int      @map("total_items")
  notes            String?  @db.Text
  receivedBy       BigInt   @map("received_by")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         PurchaseReceiptItem[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  BigInt  @id @default(autoincrement())
  tenantId            BigInt  @map("tenant_id")
  purchaseReceiptId   BigInt  @map("purchase_receipt_id")
  purchaseOrderItemId BigInt  @map("purchase_order_item_id")
  productId           BigInt  @map("product_id")
  quantityReceived    Int     @map("quantity_received")
  unitCost            Decimal @map("unit_cost") @db.Decimal(15, 4)
  batchNumber         String? @map("batch_number") @db.VarChar(50)
  expiryDate          DateTime? @map("expiry_date")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseReceipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseReceiptId])
  @@index([productId])
  @@map("purchase_receipt_items")
}

model PurchaseReturn {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  returnNumber    String   @map("return_number") @db.VarChar(50)
  purchaseOrderId BigInt?  @map("purchase_order_id")
  vendorId        BigInt   @map("vendor_id")
  returnDate      DateTime @map("return_date")
  totalAmount     Decimal  @db.Decimal(15, 2)
  reason          String   @db.Text
  status          String   @default("PENDING") @db.VarChar(20)
  approvedBy        BigInt?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  paidBy            BigInt?   @map("paid_by")
  paidAt            DateTime? @map("paid_at")
  createdBy         BigInt    @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  vendor        Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items         PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id              BigInt  @id @default(autoincrement())
  tenantId        BigInt  @map("tenant_id")
  purchaseReturnId BigInt @map("purchase_return_id")
  productId       BigInt  @map("product_id")
  quantityReturned Int    @map("quantity_returned")
  unitCost        Decimal @map("unit_cost") @db.Decimal(15, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(15, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

// ============================================================
// SALES & POS
// ============================================================

model Sale {
  id             BigInt    @id @default(autoincrement())
  tenantId       BigInt    @map("tenant_id")
  saleNumber     String    @map("sale_number") @db.VarChar(50)
  customerId     BigInt?   @map("customer_id")
  saleDate       DateTime  @map("sale_date")
  subtotal       Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount     Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount   Decimal   @default(0) @map("change_amount") @db.Decimal(15, 2)
  status         String    @default("DRAFT") @db.VarChar(20)
  paymentStatus  String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  notes          String?   @db.Text
  heldBy         BigInt?   @map("held_by")
  heldAt         DateTime? @map("held_at")
  completedBy    BigInt?   @map("completed_by")
  completedAt    DateTime? @map("completed_at")
  voidReason     String?   @map("void_reason") @db.Text
  tierId         BigInt?   @map("tier_id")
  tierName       String?   @map("tier_name") @db.VarChar(100)
  tierDiscount   Decimal?  @map("tier_discount") @db.Decimal(5, 2)
  createdBy      BigInt    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  financialYearId BigInt?  @map("financial_year_id")
  offlineId     String?   @unique @map("offline_id")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  financialYear FinancialYear?  @relation(fields: [financialYearId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("createdSales", fields: [createdBy], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  salesReturns  SalesReturn[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id             BigInt  @id @default(autoincrement())
  tenantId       BigInt  @map("tenant_id")
  saleId         BigInt  @map("sale_id")
  productId      BigInt  @map("product_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(15, 4)
  unitCost       Decimal @map("unit_cost") @db.Decimal(15, 4)
  taxRate        Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 4)
  lineTotal      Decimal @map("line_total") @db.Decimal(15, 4)
  cogsAmount     Decimal @map("cogs_amount") @db.Decimal(15, 4)
  profitAmount   Decimal @map("profit_amount") @db.Decimal(15, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale         Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems  SalesReturnItem[]

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  saleId          BigInt   @map("sale_id")
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  amount          Decimal  @db.Decimal(15, 2)
  referenceNumber String?  @map("reference_number") @db.VarChar(50)
  notes           String?  @db.Text
  createdBy       BigInt   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_payments")
}

model SalesReturn {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  returnNumber String    @map("return_number") @db.VarChar(50)
  saleId       BigInt    @map("sale_id")
  customerId   BigInt    @map("customer_id")
  returnDate   DateTime  @map("return_date")
  totalAmount  Decimal   @db.Decimal(15, 2)
  reason       String    @db.Text
  status        String    @default("PENDING") @db.VarChar(20)
  approvedBy    BigInt?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  rejectedBy    BigInt?   @map("rejected_by")
  rejectedAt    DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason") @db.Text
  createdBy     BigInt    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id             BigInt  @id @default(autoincrement())
  tenantId       BigInt  @map("tenant_id")
  salesReturnId  BigInt  @map("sales_return_id")
  saleItemId     BigInt  @map("sale_item_id")
  productId      BigInt  @map("product_id")
  quantityReturned Int   @map("quantity_returned")
  unitPrice      Decimal @map("unit_price") @db.Decimal(15, 4)
  lineTotal      Decimal @map("line_total") @db.Decimal(15, 4)
  warehouseId    BigInt  @map("warehouse_id")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([salesReturnId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sales_return_items")
}

model ReturnProcessingLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @map("tenant_id")
  saleId       BigInt   @map("sale_id")
  returnNumber String   @map("return_number") @db.VarChar(50)
  status       String   @db.VarChar(20)
  errorMessage String?  @map("error_message") @db.Text
  cartData     Json?    @map("cart_data")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([status])
  @@map("return_processing_logs")
}

// ============================================================
// EXPENSES
// ============================================================

model ExpenseCategory {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isRecurring Boolean  @default(false) @map("is_recurring")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id                BigInt    @id @default(autoincrement())
  tenantId          BigInt    @map("tenant_id")
  expenseNumber     String    @map("expense_number") @db.VarChar(50)
  categoryId        BigInt    @map("category_id")
  expenseDate       DateTime  @map("expense_date")
  amount            Decimal   @db.Decimal(15, 2)
  description       String    @db.Text
  vendorName        String?   @map("vendor_name") @db.VarChar(200)
  attachmentPath    String?   @map("attachment_path") @db.VarChar(255)
  isRecurring       Boolean   @default(false) @map("is_recurring")
  recurringFrequency String?  @map("recurring_frequency") @db.VarChar(10)
  nextDueDate       DateTime? @map("next_due_date")
  status            String    @default("PENDING") @db.VarChar(20)
  approvedBy        BigInt?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  paidBy            BigInt?   @map("paid_by")
  paidAt            DateTime? @map("paid_at")
  createdBy         BigInt    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  financialYearId   BigInt?   @map("financial_year_id")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  financialYear FinancialYear?   @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  @@unique([tenantId, expenseNumber])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================================
// ACCOUNTING
// ============================================================

model ChartOfAccount {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  accountCode    String   @map("account_code") @db.VarChar(20)
  accountName    String   @map("account_name") @db.VarChar(200)
  accountType    String   @map("account_type") @db.VarChar(20)
  parentId       BigInt?  @map("parent_id")
  isBankAccount  Boolean  @default(false) @map("is_bank_account")
  isActive       Boolean  @default(true) @map("is_active")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     ChartOfAccount[]   @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([accountType])
  @@index([parentId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id             BigInt    @id @default(autoincrement())
  tenantId       BigInt    @map("tenant_id")
  entryNumber    String    @map("entry_number") @db.VarChar(50)
  entryDate      DateTime  @map("entry_date")
  referenceType  String?   @map("reference_type") @db.VarChar(50)
  referenceId    BigInt?   @map("reference_id")
  description    String    @db.Text
  totalDebit     Decimal   @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit    Decimal   @default(0) @map("total_credit") @db.Decimal(15, 2)
  isReversed     Boolean   @default(false) @map("is_reversed")
  reversedEntryId BigInt?  @map("reversed_entry_id")
  reversedBy     BigInt?   @map("reversed_by")
  reversedAt     DateTime? @map("reversed_at")
  createdBy      BigInt    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  financialYearId BigInt?  @map("financial_year_id")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reversedEntry  JournalEntry?      @relation("ReversedEntries", fields: [reversedEntryId], references: [id], onDelete: SetNull)
  reversingEntry JournalEntry[]     @relation("ReversedEntries")
  financialYear  FinancialYear?     @relation(fields: [financialYearId], references: [id], onDelete: SetNull)
  lines          JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([entryDate])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             BigInt  @id @default(autoincrement())
  tenantId       BigInt  @map("tenant_id")
  journalEntryId BigInt  @map("journal_entry_id")
  accountId      BigInt  @map("account_id")
  debitAmount    Decimal @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount   Decimal @default(0) @map("credit_amount") @db.Decimal(15, 2)
  description    String? @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model LoanParty {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  name        String   @db.VarChar(200)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  address     String?  @db.Text
  type        String   @default("INDIVIDUAL") @db.VarChar(20)
  cnic        String?  @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loansGiven  Loan[]   @relation("LoanBorrower")
  loansTaken  Loan[]   @relation("LoanLender")
  @@index([tenantId])
  @@map("loan_parties")
}

model Loan {
  id              BigInt        @id @default(autoincrement())
  tenantId        BigInt        @map("tenant_id")
  loanNumber      String        @map("loan_number") @db.VarChar(50)
  type            String        @db.VarChar(20)
  borrowerId      BigInt?       @map("borrower_id")
  lenderId        BigInt?       @map("lender_id")
  principalAmount Decimal       @map("principal_amount") @db.Decimal(15, 2)
  interestRate    Decimal       @default(0) @map("interest_rate") @db.Decimal(5, 2)
  startDate       DateTime      @map("start_date")
  dueDate         DateTime?     @map("due_date")
  status          String        @default("ACTIVE") @db.VarChar(20)
  notes           String?       @db.Text
  totalPaid       Decimal       @default(0) @map("total_paid") @db.Decimal(15, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(15, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  borrower        LoanParty?    @relation("LoanBorrower", fields: [borrowerId], references: [id])
  lender          LoanParty?    @relation("LoanLender", fields: [lenderId], references: [id])
  payments        LoanPayment[]
  @@unique([tenantId, loanNumber])
  @@index([tenantId])
  @@index([borrowerId])
  @@index([lenderId])
  @@map("loans")
}

model LoanPayment {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt   @map("tenant_id")
  loanId        BigInt   @map("loan_id")
  amount        Decimal  @db.Decimal(15, 2)
  paymentDate   DateTime @map("payment_date")
  paymentMethod String   @default("CASH") @map("payment_method") @db.VarChar(30)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  @@index([loanId])
  @@map("loan_payments")
}

model FinancialYear {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt    @map("tenant_id")
  name       String    @db.VarChar(50)
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("OPEN") @db.VarChar(10)
  closedAt   DateTime? @map("closed_at")
  closedBy   BigInt?   @map("closed_by")
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales           Sale[]
  expenses        Expense[]
  journalEntries  JournalEntry[]
  purchaseOrders  PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("financial_years")
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  key       String  @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("settings")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt    @map("tenant_id")
  userId    BigInt?   @map("user_id")
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  data      Json?     @default("{}")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ImportHistory {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  entityType  String   @map("entity_type") @db.VarChar(50)
  filename    String   @db.VarChar(255)
  totalRows   Int      @default(0) @map("total_rows")
  imported    Int      @default(0)
  skipped     Int      @default(0)
  errors      Int      @default(0)
  status      String   @default("COMPLETED") @db.VarChar(20)
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("import_history")
}

model BackupRecord {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt    @map("tenant_id")
  filename        String    @db.VarChar(255)
  storagePath     String    @map("storage_path") @db.VarChar(500)
  storageDriver   String    @default("local") @map("storage_driver") @db.VarChar(20)
  fileSize        BigInt    @default(0) @map("file_size")
  checksum        String?   @db.VarChar(64)
  backupType      String    @default("full") @map("backup_type") @db.VarChar(30)
  compression     String    @default("gzip") @db.VarChar(10)
  status          String    @default("pending") @db.VarChar(20)
  appVersion      String?   @map("app_version") @db.VarChar(50)
  schemaVersion   String?   @map("schema_version") @db.VarChar(50)
  recordCounts    Json?     @map("record_counts")
  durationMs      Int?      @map("duration_ms")
  createdBy       BigInt?   @map("created_by")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  restoredAt      DateTime? @map("restored_at")
  restoredBy      BigInt?   @map("restored_by")
  errorMessage    String?   @map("error_message") @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  creator  User? @relation("BackupCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  restorer User? @relation("BackupRestorer", fields: [restoredBy], references: [id], onDelete: SetNull)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@index([status])
  @@map("backup_records")
}

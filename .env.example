# ============================================
# SITARA SaaS - Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://sitara:sitara_pass@localhost:5432/sitara_saas?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Storage (Hetzner Object Storage / S3-compatible)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=sitara-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@sitara.pk

# WhatsApp (for v1.1+)
WHATSAPP_API_KEY=

# Monitoring (Sentry)
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
